<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block access to sensitive configuration and source files
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|package\.(json|lock)|database/.*\.sqlite) - [F,L,NC]

    # If the request is not already pointing to /public/, rewrite it to public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
